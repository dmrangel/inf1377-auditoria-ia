@startuml
' Diagrama de Casos de Uso - Plataforma de Hospedagem (Airbnb)
' INF1377 - Engenharia de Requisitos - Apendice B.2 da ERS v1.2

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam nodesep 20
skinparam ranksep 90
skinparam ArrowColor #444444
skinparam actor {
  BorderColor #1F3A5F
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BorderColor #1F3A5F
  BackgroundColor #F2F6FA
  FontColor #111111
}
skinparam rectangle {
  BorderColor #666666
  BackgroundColor #FFFFFF
  FontSize 15
  FontStyle bold
}

actor "Visitante" as VIS
actor "Usuário" as USU
actor "Hóspede" as HOS
actor "Anfitrião" as ANF
actor "Administrador" as ADM

rectangle "Plataforma de Hospedagem" {
  usecase "UC01\nCadastrar usuário" as UC01
  usecase "UC08\nPesquisar\nacomodações" as UC08
  usecase "UC09\nConsultar detalhes\nda acomodação" as UC09
  usecase "UC20\nConsultar avaliações" as UC20

  usecase "UC02\nEfetuar login" as UC02
  usecase "UC03\nAlterar dados\ncadastrais" as UC03
  usecase "UC21\nDenunciar anúncio\nou usuário" as UC21

  usecase "UC04\nTornar-se anfitrião" as UC04
  usecase "UC10\nSolicitar reserva" as UC10
  usecase "UC16\nEfetuar pagamento\nda reserva" as UC16
  usecase "UC12\nCancelar reserva" as UC12
  usecase "UC17\nProcessar reembolso" as UC17
  usecase "UC15\nConsultar reservas" as UC15
  usecase "UC18\nAvaliar estadia" as UC18

  usecase "UC13\nRegistrar check-in" as UC13
  usecase "UC14\nRegistrar check-out" as UC14
  usecase "UC19\nAvaliar hóspede" as UC19
  usecase "UC05\nCadastrar\nacomodação" as UC05
  usecase "UC06\nAlterar acomodação" as UC06
  usecase "UC07\nRemover acomodação" as UC07

  usecase "UC22\nAnalisar denúncia" as UC22
}

actor "Gateway de\nPagamento" as GW
actor "Serviço\nde E-mail" as MAIL
actor "Serviço\nde CEP" as CEP
actor "Serviço\nde Mapas" as MAPA
actor "Armazenamento\nde Arquivos" as ARQ

' ---- Generalização de atores ----
VIS <|-- USU
USU <|-- HOS
USU <|-- ANF

' ---- Visitante (não precisa estar logado) ----
VIS -- UC01
VIS -- UC08
VIS -- UC09
VIS -- UC20

' ---- Usuário (qualquer conta autenticada) ----
USU -- UC02
USU -- UC03
USU -- UC21

' ---- Hóspede ----
HOS -- UC04
HOS -- UC10
HOS -- UC16
HOS -- UC12
HOS -- UC15
HOS -- UC18

' ---- Anfitrião ----
ANF -- UC05
ANF -- UC06
ANF -- UC07
ANF -- UC12
ANF -- UC13
ANF -- UC14
ANF -- UC15
ANF -- UC19

' ---- Administrador ----
ADM -- UC22

' ---- Atores externos ----
UC16 -- GW
UC17 -- GW
UC01 -- MAIL
UC16 -- MAIL
UC12 -- MAIL
UC05 -- CEP
UC06 -- CEP
UC09 -- MAPA
UC05 -- ARQ
UC06 -- ARQ

' ---- include e extend ----
UC16 .> UC10 : <<extend>>
UC17 .> UC12 : <<extend>>
UC20 .> UC09 : <<extend>>

@enduml
